# packages/db local dev environment — needed to run this package's own
# tests (npm test) or the migration runner (src/migrate.ts) directly,
# outside of apps/web or apps/agent-runtime (which supply their own copy
# of DATABASE_URL). Copy to .env.

# Either DATABASE_URL (local Postgres / any single connection string) OR
# the discrete PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD (see src/client.ts —
# production ECS gets the discrete form from RDS's own Secrets Manager
# entry, which has no single URL field).
DATABASE_URL=postgres://user:password@localhost:5432/foundry

# Encrypts/decrypts stored OAuth tokens (src/crypto.ts) — only needed if
# you're running code that touches the `integrations` table's
# encryptedToken column (e.g. orgs.test.ts doesn't need it, but anything
# exercising the GitHub/Google Calendar connection flow does). base64,
# must decode to exactly 32 bytes (openssl rand -base64 32).
GITHUB_TOKEN_ENCRYPTION_KEY=
