# apps/agent-runtime (eve runtime) local dev environment. Copy to .env and
# fill in real values — see DEPLOY.md for where each of these comes from in
# production (AWS Secrets Manager).
#
# Built by grepping this package's own source (agent/**/*.ts) for every
# process.env.X reference, plus ANTHROPIC_API_KEY and CLERK_SECRET_KEY
# which eve/@ai-sdk/anthropic and @clerk/backend read implicitly by their
# standard names — cross-checked against infra/lib/foundry-stack.ts's
# `appSecrets` (the real deployed list) so this doesn't drift from what
# production actually needs.

# --- Database (Drizzle, via @foundry/db — same as apps/web) ---
DATABASE_URL=postgres://user:password@localhost:5432/foundry

# --- Clerk (verifying the org/user on each incoming session — see agent/lib/clerk-org-auth.ts) ---
CLERK_SECRET_KEY=sk_test_...
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json

# --- Claude, via @ai-sdk/anthropic (every agent.ts's model) ---
ANTHROPIC_API_KEY=

# --- This app's own public URL (used to build links in notification emails, e.g. deps-db.ts) ---
APP_URL=http://localhost:3312

# --- Transactional email (approval-request notifications, packages/guardrails/src/deps-db.ts) ---
RESEND_API_KEY=

# --- S3 project-file storage (agent/lib/s3-client.ts) ---
# No access key needed locally if your AWS CLI profile already has S3
# access — the SDK falls back to the default credential chain. This is
# just the bucket name.
PROJECT_FILES_BUCKET=

# --- Google/GitHub connection tokens ---
# Same key apps/web uses to encrypt the stored GitHub/Google tokens
# (packages/db/src/crypto.ts) — needed here too since this app decrypts
# them (github-connection-auth.ts, google-calendar-connection-auth.ts).
GITHUB_TOKEN_ENCRYPTION_KEY=
# Same OAuth app as apps/web/.env.example's GOOGLE_OAUTH_CLIENT_ID/SECRET —
# needed here too because this app refreshes the access token itself
# (Google's tokens expire in ~1hr; GitHub's don't, which is why there's no
# GITHUB_OAUTH_CLIENT_ID/SECRET here, only apps/web has those).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Voice phone-call agent (agent/lib/twilio-call.ts, ops-manager/tools/place_call.ts) ---
# Platform-level Twilio account, not per-org — see DEPLOY.md step 7.
# Optional: place_call fails with a clear error (not a crash) if unset.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Telegram channel (agent/channels/telegram.ts, agent/lib/telegram-link.ts) ---
# Platform-level bot, one for every org — see DEPLOY.md step 8 for the
# BotFather + setWebhook setup this doesn't do automatically.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Phase 0 OpenClaw-modeled runtime core (runtime-core/server.ts) ---
# Required — the server refuses to start without it. Shared bearer token
# apps/web would send as `Authorization: Bearer <token>`; this internal
# server has no other request auth. Generate with e.g. openssl rand -hex 32.
RUNTIME_CORE_INTERNAL_TOKEN=

# exec_host.ts / clone_repo.ts run directly on this container, no flag
# needed for the normal single-org deployment. Only set this to "true" if
# you're intentionally running the *default* stack itself for more than
# one org (one database, one container, genuinely shared) — see DEPLOY.md
# §1's "Running the default stack for more than one org". Not related to
# deploying a second, separately-orgName-scoped stack (DEPLOY.md §6) —
# that's fully isolated and doesn't need this.
FOUNDRY_SHARED_INSTANCE=
