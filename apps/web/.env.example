# apps/web local dev environment. Copy to .env.local and fill in real
# values — see DEPLOY.md for where each of these comes from in production
# (AWS Secrets Manager, provider dashboards).
#
# Built by grepping this package's own source for every process.env.X
# reference (apps/web/lib/eve-client.ts, stripe.ts, and the
# connections/*/actions.ts + callback routes) plus the handful of vars that
# Clerk/Stripe's own SDKs read implicitly by their standard names rather
# than through explicit process.env calls in our code — cross-checked
# against infra/lib/foundry-stack.ts's `appSecrets` (the real deployed
# list) so this doesn't drift from what production actually needs.

# --- Database (Drizzle, via @foundry/db) ---
# Either DATABASE_URL (local Postgres / any single connection string) OR
# the discrete PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD (what production
# ECS gets from RDS's own Secrets Manager entry, no single URL field there)
DATABASE_URL=postgres://user:password@localhost:5432/foundry

# --- Clerk auth (read implicitly by @clerk/nextjs, not via process.env in our code) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json

# --- This app's own URLs ---
# Public URL this app is served at (used to build OAuth callback redirect_uris)
NEXT_PUBLIC_APP_URL=http://localhost:3311
# Where apps/agent-runtime is reachable from this app (see lib/eve-client.ts)
AGENT_RUNTIME_URL=http://localhost:3312

# --- Stripe billing (apps/web/lib/stripe.ts, dashboard/billing/) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- GitHub connection OAuth App (dashboard/connections) ---
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Shared with apps/agent-runtime — encrypts/decrypts the stored OAuth
# token (packages/db/src/crypto.ts). base64, must decode to 32 bytes
# (openssl rand -base64 32). Also used for the Google Calendar token.
GITHUB_TOKEN_ENCRYPTION_KEY=

# --- Google Calendar connection OAuth app (dashboard/connections) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Telegram channel (dashboard/connections — just the @handle shown to
# users; the actual bot token only lives in apps/agent-runtime's env) ---
TELEGRAM_BOT_USERNAME=

# --- Real live terminal (dashboard/run's node-pty terminal on
# apps/agent-runtime's runtime-core/server.ts) ---
# Same value as apps/agent-runtime's RUNTIME_CORE_INTERNAL_TOKEN. Used
# server-side only, to mint short-lived per-session terminal tokens after
# this app's own Clerk auth + run_sessions ownership check — never sent to
# the browser directly. See app/api/terminal-token/[sessionId]/route.ts.
RUNTIME_CORE_INTERNAL_TOKEN=
