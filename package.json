{
  "name": "foundry",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e",
    "infra"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
